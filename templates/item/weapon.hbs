<section class="gaia-sheet-content">
  <header class="sheet-header flexrow">
    <img src="{{item.img}}" data-edit="img" title="{{item.name}}" height="64" width="64"/>
    <h1><input name="name" type="text" value="{{item.name}}" placeholder="Nome da Arma"/></h1>
  </header>

  <div class="sheet-body">
    <div class="form-group">
      <label>Tipo de Arma</label>
      <select name="system.weaponType">
        {{selectOptions config.weaponTypes selected=system.weaponType localize=true}}
      </select>
    </div>

    <div class="form-group">
      <label>Dano Base</label>
      <input type="number" name="system.damageType.value" value="{{system.damageType.value}}" />
    </div>

    <div class="form-group">
      <label>Tipo de Dano</label>
      <input type="text" name="system.damageType.type" value="{{system.damageType.type}}" />
    </div>

    <div class="form-group">
      <label>Parâmetro de Ataque (Atributo)</label>
      <select name="system.attackParameter.attribute">
        {{selectOptions config.parameters selected=system.attackParameter.attribute localize=true}}
      </select>
    </div>

    <div class="form-group">
      <label>Alcance</label>
      <input type="number" name="system.range.value" value="{{system.range.value}}" />
    </div>

    <div class="form-group">
      <label>Preço</label>
      <input type="number" name="system.price" value="{{system.price}}" />
    </div>

    <div class="form-group">
      <label>Categoria</label>
      <select name="system.category">
        {{selectOptions config.equipmentCategories selected=system.category localize=true}}
      </select>
    </div>

    <div class="form-group">
      <label>Unidade / Peso</label>
      <input type="number" name="system.unity" value="{{system.unity}}" />
    </div>

    <div class="form-group stacked">
      <label>Descrição</label>
      <textarea name="system.description">{{system.description}}</textarea>
    </div>
  </div>
</section>
