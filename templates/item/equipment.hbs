<section class="gaia-sheet-content">
  <header class="sheet-header flexrow">
    <img src="{{item.img}}" data-edit="img" title="{{item.name}}" height="64" width="64"/>
    <h1><input name="name" type="text" value="{{item.name}}" placeholder="Nome do Equipamento"/></h1>
  </header>

  <div class="sheet-body">
    <div class="form-group">
      <label>Preço</label>
      <input type="number" name="system.price" value="{{system.price}}" />
    </div>

    <div class="form-group">
      <label>Categoria</label>
      <select name="system.category">
        {{selectOptions config.equipmentCategories selected=system.category localize=true}}
      </select>
    </div>

    <div class="form-group">
      <label>Unidade / Peso</label>
      <input type="number" name="system.unity" value="{{system.unity}}" />
    </div>

    <div class="form-group stacked">
      <label>Descrição</label>
      <textarea name="system.description">{{system.description}}</textarea>
    </div>
  </div>
</section>
