<section class="gaia-sheet-content">
  <div class="inventory-table-panel tab-weapons-content">
    <div class="inventory-table-header">
      <div class="item-header-group">
        <img class="item-mini-icon" src="{{item.img}}" data-action="editImage" data-edit="img" title="{{item.name}}"/>
        <h4 class="inventory-table-title">
          <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'GAIA.Equipment.NamePlaceholder'}}"/>
        </h4>
      </div>
    </div>

    <div class="weapons-table-frame">
      <table class="inventory-grid-table">
        <thead>
          <tr>
            <th class="col-equip-price">{{localize "GAIA.Equipment.Price"}}</th>
            <th class="col-equip-category">{{localize "GAIA.Equipment.Category"}}</th>
            <th class="col-equip-qty">{{localize "GAIA.Equipment.Quantity"}}</th>
            <th class="col-equip-unity">{{localize "GAIA.Equipment.Weight"}}</th>
          </tr>
        </thead>
        <tbody>
          <tr class="item-row">
            <td class="col-equip-price">
              <input type="number" name="system.price" value="{{system.price}}" min="0" />
            </td>
            <td class="col-equip-category">
              <select name="system.category">
                {{selectOptions config.equipmentCategories selected=system.category localize=true}}
              </select>
            </td>
            <td class="col-equip-qty">
              <input type="number" name="system.quantity" value="{{system.quantity}}" min="1" />
            </td>
            <td class="col-equip-unity">
              <input type="number" name="system.unity" value="{{system.unity}}" min="0" step="any" />
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="weapon-description-panel">
      <label class="description-title">{{localize "GAIA.Equipment.Description"}}</label>
      <textarea name="system.description" class="equipment-description-textarea" placeholder="{{localize 'GAIA.Equipment.DescriptionPlaceholder'}}">{{system.description}}</textarea>
    </div>
  </div>
</section>
