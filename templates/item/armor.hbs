<section class="gaia-sheet-content">
  <div class="inventory-table-panel tab-weapons-content">
    <div class="inventory-table-header">
      <div class="item-header-group">
        <img class="item-mini-icon" src="{{item.img}}" data-action="editImage" data-edit="img" title="{{item.name}}"/>
        <h4 class="inventory-table-title">
          <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'GAIA.Armor.NamePlaceholder'}}"/>
        </h4>
      </div>
    </div>

    <div class="weapons-table-frame">
      <table class="inventory-grid-table">
        <thead>
          <tr>
            <th class="col-armor-block">{{localize "GAIA.Armor.BlockDefense"}}</th>
            <th class="col-armor-price">{{localize "GAIA.Armor.Price"}}</th>
            <th class="col-armor-category">{{localize "GAIA.Armor.ArmorType"}}</th>
            <th class="col-armor-unity">{{localize "GAIA.Armor.Weight"}}</th>
          </tr>
        </thead>
        <tbody>
          <tr class="item-row">
            <td class="col-armor-block">
              <input type="number" name="system.block" value="{{system.block}}" min="0" />
            </td>
            <td class="col-armor-price">
              <input type="number" name="system.price" value="{{system.price}}" min="0" />
            </td>
            <td class="col-armor-category">
              <select name="system.armorType">
                {{selectOptions config.armorTypes selected=system.armorType localize=true}}
              </select>
            </td>
            <td class="col-armor-unity">
              <input type="number" name="system.unity" value="{{system.unity}}" min="0" step="any" />
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="weapon-description-panel">
      <label class="description-title">{{localize "GAIA.Armor.Description"}}</label>
      <textarea name="system.description" class="weapon-description-textarea" placeholder="{{localize 'GAIA.Armor.DescriptionPlaceholder'}}">{{system.description}}</textarea>
    </div>
  </div>
</section>
