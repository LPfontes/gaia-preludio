<section class="gaia-sheet-content">
  <div class="inventory-table-panel tab-weapons-content">
    <div class="inventory-table-header">
      <div class="item-header-group">
        <img class="item-mini-icon" src="{{item.img}}" data-action="editImage" data-edit="img" title="{{item.name}}"/>
        <h4 class="inventory-table-title">
          <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'GAIA.Armor.NamePlaceholder'}}"/>
        </h4>
      </div>
    </div>

    {{!-- NAVEGAÇÃO POR ABAS DO ITEM --}}
    <nav class="sheet-navigation-tabs item-tabs tabs" data-group="primary">
      <a class="tab-item active" data-action="tab" data-group="primary" data-tab="tabela">{{localize "GAIA.ItemTabs.Table"}}</a>
      <a class="tab-item" data-action="tab" data-group="primary" data-tab="acoes">{{localize "GAIA.ItemTabs.Actions"}}</a>
      <a class="tab-item" data-action="tab" data-group="primary" data-tab="efeitos">{{localize "GAIA.ItemTabs.Effects"}}</a>
    </nav>

    <section class="sheet-tabs-content item-tabs-content">
      {{!-- ABA 1: TABELA --}}
      <div class="tab tabela active" data-group="primary" data-tab="tabela">
        <div class="weapons-table-frame">
          <table class="inventory-grid-table">
            <thead>
              <tr>
                <th class="col-armor-block">{{localize "GAIA.Armor.BlockDefense"}}</th>
                <th class="col-armor-price">{{localize "GAIA.Armor.Price"}}</th>
                <th class="col-armor-category">{{localize "GAIA.Armor.ArmorType"}}</th>
                <th class="col-armor-requirement">{{localize "GAIA.Armor.Requirement"}}</th>
                <th class="col-armor-unity">{{localize "GAIA.Armor.Weight"}}</th>
              </tr>
            </thead>
            <tbody>
              <tr class="item-row">
                <td class="col-armor-block">
                  <input type="number" name="system.block" value="{{system.block}}" min="0" />
                </td>
                <td class="col-armor-price">
                  <input type="number" name="system.price" value="{{system.price}}" min="0" />
                </td>
                <td class="col-armor-category">
                  <select name="system.armorType">
                    {{selectOptions config.armorTypes selected=system.armorType localize=true}}
                  </select>
                </td>
                <td class="col-armor-requirement">
                  <div style="display: flex; gap: 4px;">
                    <select name="system.requirement.type" style="flex: 2;">
                      {{selectOptions config.parameters selected=system.requirement.type localize=true}}
                    </select>
                    <input type="number" name="system.requirement.value" value="{{system.requirement.value}}" min="0" style="flex: 1; text-align: center;" />
                  </div>
                </td>
                <td class="col-armor-unity">
                  <input type="number" name="system.unity" value="{{system.unity}}" min="0" step="any" />
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="weapon-description-panel" style="margin-top: 15px;">
          <label class="description-title">{{localize "GAIA.Armor.Description"}}</label>
          <textarea name="system.description" class="armor-description-textarea" placeholder="{{localize 'GAIA.Armor.DescriptionPlaceholder'}}">{{system.description}}</textarea>
        </div>
      </div>

      {{!-- ABA 2: AÇÕES --}}
      <div class="tab acoes" data-group="primary" data-tab="acoes">
        {{> "systems/gaia-preludio/templates/item/parts/item-actions.hbs"}}
      </div>

      {{!-- ABA 3: EFEITOS --}}
      <div class="tab efeitos" data-group="primary" data-tab="efeitos">
        {{> "systems/gaia-preludio/templates/item/parts/item-effects.hbs"}}
      </div>
    </section>
  </div>
</section>
