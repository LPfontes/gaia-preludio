<section class="gaia-sheet-content">
  <div class="inventory-table-panel tab-legacy-content">
    <div class="inventory-table-header">
      <div class="item-header-group">
        <img class="item-mini-icon" src="{{item.img}}" data-action="editImage" data-edit="img" title="{{item.name}}" />
        <h4 class="inventory-table-title">
          <input name="name" type="text" value="{{item.name}}"
            placeholder="{{localize 'GAIA.Legado.NamePlaceholder'}}" />
        </h4>
      </div>
    </div>

    <div class="legacy-table-frame">
      <table class="inventory-grid-table">
        <thead>
          <tr>
            <th>{{localize "GAIA.Legado.Height"}}</th>
            <th>{{localize "GAIA.Legado.LifeExpectancy"}}</th>
            <th class="col-edit" style="width: 36px; text-align: center;"><i class="fa-solid fa-gear"></i></th>
          </tr>
        </thead>
        <tbody>
          <tr class="item-row">
            <td>
              <input type="text" name="system.height" value="{{system.height}}"
                placeholder="{{localize 'GAIA.Legado.HeightPlaceholder'}}" />
            </td>
            <td>
              <input type="text" name="system.lifeExpectancy" value="{{system.lifeExpectancy}}"
                placeholder="{{localize 'GAIA.Legado.LifeExpectancyPlaceholder'}}" />
            </td>
            <td class="col-edit" style="text-align: center; vertical-align: middle;">
              <button type="button" class="btn-toggle-table-edit" data-action="toggleTableEdit" title="Editar" style="cursor: pointer; background: transparent; border: none; color: var(--gaia-text-parchment);"><i class="fa-solid fa-pen"></i></button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="legacy-appearance-panel">
      <label class="description-title">{{localize "GAIA.Legado.Appearance"}}</label>
      <textarea name="system.appearance" class="legacy-appearance-textarea"
        placeholder="{{localize 'GAIA.Legado.AppearancePlaceholder'}}">{{system.appearance}}</textarea>
    </div>

        <div class="legacy-description-panel">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label class="description-title">{{localize "GAIA.Legado.Origin"}}</label>
          <button type="button" class="btn-toggle-description-edit" data-action="toggleDescriptionEdit" title="Editar" style="cursor: pointer; background: transparent; border: none; color: var(--gaia-text-parchment); padding: 0 4px;"><i class="fa-solid fa-pen"></i></button>
        </div>
        <textarea name="system.origin" class="legacy-description-textarea"
          placeholder="{{localize 'GAIA.Legado.OriginPlaceholder'}}">{{system.origin}}</textarea>
      </div>

      <div class="legacy-description-panel" style="margin-top: 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label class="description-title">{{localize "GAIA.Legado.Traditions"}}</label>
          <button type="button" class="btn-toggle-description-edit" data-action="toggleDescriptionEdit" title="Editar" style="cursor: pointer; background: transparent; border: none; color: var(--gaia-text-parchment); padding: 0 4px;"><i class="fa-solid fa-pen"></i></button>
        </div>
        <textarea name="system.traditions" class="legacy-description-textarea"
          placeholder="{{localize 'GAIA.Legado.TraditionsPlaceholder'}}">{{system.traditions}}</textarea>
      </div>

      <div class="legacy-description-panel" style="margin-top: 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label class="description-title">{{localize "GAIA.Legado.InWorld"}}</label>
          <button type="button" class="btn-toggle-description-edit" data-action="toggleDescriptionEdit" title="Editar" style="cursor: pointer; background: transparent; border: none; color: var(--gaia-text-parchment); padding: 0 4px;"><i class="fa-solid fa-pen"></i></button>
        </div>
        <textarea name="system.inWorld" class="legacy-description-textarea"
          placeholder="{{localize 'GAIA.Legado.InWorldPlaceholder'}}">{{system.inWorld}}</textarea>
      </div>

    <div class="legacy-abilities-section">
      <div class="section-header">
        <h3 class="panel-main-title">{{localize "GAIA.Legado.AbilitiesTitle"}}</h3>
        <button type="button" class="btn-add-ability" data-action="addLegacyAbility"
          title="{{localize 'GAIA.Legado.AddAbilityTitle'}}">
          <i class="fa-solid fa-plus"></i> {{localize "GAIA.Legado.AddAbilityBtn"}}
        </button>
      </div>

      {{#each legacyAbilities as |ability index|}}
      <div class="legacy-ability-card">
        <div class="legacy-ability-header">
          <h4 class="legacy-ability-title" data-action="editLegacyAbility" data-index="{{index}}"
            title="Clique para editar">
            {{ability.name}}
          </h4>
          <div class="legacy-ability-controls">
            <button type="button" class="btn-edit-ability" data-action="editLegacyAbility" data-index="{{index}}"
              title="Editar Habilidade">
              <i class="fa-solid fa-pen-to-square"></i>
            </button>
            <button type="button" class="btn-remove-ability" data-action="removeLegacyAbility" data-index="{{index}}"
              title="{{localize 'GAIA.Legado.RemoveAbilityTitle'}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>

        {{#if ability.description}}
        <div class="legacy-ability-preview-description">
          {{ability.description}}
        </div>
        {{/if}}

        {{#if ability.activeEffectText}}
        <div class="legacy-ability-preview-effect">
          <strong class="active-effect-label">{{localize "GAIA.Legado.ActiveEffectLabel"}}:</strong>
          {{ability.activeEffectText}}
        </div>
        {{/if}}

        {{#if ability.formattedActions.length}}
        <div class="legacy-ability-actions-list">
          {{#each ability.formattedActions as |action aIdx|}}
          <div class="legacy-ability-action-row">
            <span><strong class="action-name">{{action.name}}</strong> {{#if action.summary}}<small class="action-summary">({{action.summary}})</small>{{/if}}</span>
            <button type="button" class="btn-roll-legacy-action" data-action="rollLegacyAction"
              data-ability-index="{{ability.index}}" data-action-index="{{aIdx}}"
              title="{{localize 'GAIA.Action.RollActionTitle'}}">
              <i class="fa-solid fa-comment-alt"></i>
            </button>
          </div>
          {{/each}}
        </div>
        {{/if}}
      </div>
      {{else}}
      <p class="empty-hint">{{localize "GAIA.Legado.EmptyAbilitiesHint"}}</p>
      {{/each}}
    </div>
  </div>
</section>