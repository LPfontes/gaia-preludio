<section class="gaia-sheet-content">
  <div class="inventory-table-panel tab-legacy-content">
    <div class="inventory-table-header">
      <div class="item-header-group">
        <img class="item-mini-icon" src="{{item.img}}" data-action="editImage" data-edit="img" title="{{item.name}}"/>
        <h4 class="inventory-table-title">
          <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'GAIA.Legado.NamePlaceholder'}}"/>
        </h4>
      </div>
    </div>

    <div class="legacy-table-frame">
      <table class="inventory-grid-table">
        <thead>
          <tr>
            <th>{{localize "GAIA.Legado.Height"}}</th>
            <th>{{localize "GAIA.Legado.LifeExpectancy"}}</th>
          </tr>
        </thead>
        <tbody>
          <tr class="item-row">
            <td>
              <input type="text" name="system.height" value="{{system.height}}" placeholder="{{localize 'GAIA.Legado.HeightPlaceholder'}}" />
            </td>
            <td>
              <input type="text" name="system.lifeExpectancy" value="{{system.lifeExpectancy}}" placeholder="{{localize 'GAIA.Legado.LifeExpectancyPlaceholder'}}" />
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="legacy-appearance-panel">
      <label class="description-title">{{localize "GAIA.Legado.Appearance"}}</label>
      <textarea name="system.appearance" class="legacy-appearance-textarea" placeholder="{{localize 'GAIA.Legado.AppearancePlaceholder'}}">{{system.appearance}}</textarea>
    </div>

    <div class="legacy-description-panel">
      <label class="description-title">{{localize "GAIA.Legado.Description"}}</label>
      <textarea name="system.description" class="legacy-description-textarea" placeholder="{{localize 'GAIA.Legado.DescriptionPlaceholder'}}">{{system.description}}</textarea>
    </div>

    <div class="legacy-abilities-section">
      <div class="section-header">
        <h3 class="panel-main-title">{{localize "GAIA.Legado.AbilitiesTitle"}}</h3>
        <button type="button" class="btn-add-ability" data-action="addLegacyAbility" title="{{localize 'GAIA.Legado.AddAbilityTitle'}}">
          <i class="fa-solid fa-plus"></i> {{localize "GAIA.Legado.AddAbilityBtn"}}
        </button>
      </div>

      {{#each legacyAbilities as |ability index|}}
        <div class="legacy-ability-card">
          <div class="legacy-ability-header">
            <h4 class="legacy-ability-title" data-action="editLegacyAbility" data-index="{{index}}" title="Clique para editar">
              {{ability.name}}
            </h4>
            <div class="legacy-ability-controls">
              <button type="button" class="btn-edit-ability" data-action="editLegacyAbility" data-index="{{index}}" title="Editar Habilidade">
                <i class="fa-solid fa-pen-to-square"></i>
              </button>
              <button type="button" class="btn-remove-ability" data-action="removeLegacyAbility" data-index="{{index}}" title="{{localize 'GAIA.Legado.RemoveAbilityTitle'}}">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
          
          {{#if ability.description}}
            <div class="legacy-ability-preview-description">
              {{ability.description}}
            </div>
          {{/if}}

          {{#if ability.activeEffectText}}
            <div class="legacy-ability-preview-effect">
              <strong class="active-effect-label">{{localize "GAIA.Legado.ActiveEffectLabel"}}:</strong> {{ability.activeEffectText}}
            </div>
          {{/if}}
        </div>
      {{else}}
        <p class="empty-hint">{{localize "GAIA.Legado.EmptyAbilitiesHint"}}</p>
      {{/each}}
    </div>
  </div>
</section>
