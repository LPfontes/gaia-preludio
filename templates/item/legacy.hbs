<section class="gaia-sheet-content">
  <div class="inventory-table-panel tab-weapons-content">
    <div class="inventory-table-header">
      <div class="item-header-group">
        <img class="item-mini-icon" src="{{item.img}}" data-action="editImage" data-edit="img" title="{{item.name}}"/>
        <h4 class="inventory-table-title">
          <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'GAIA.Legado.NamePlaceholder'}}"/>
        </h4>
      </div>
    </div>

    <div class="weapons-table-frame">
      <table class="inventory-grid-table">
        <thead>
          <tr>
            <th>{{localize "GAIA.Legado.Appearance"}}</th>
            <th>{{localize "GAIA.Legado.Height"}}</th>
            <th>{{localize "GAIA.Legado.LifeExpectancy"}}</th>
          </tr>
        </thead>
        <tbody>
          <tr class="item-row">
            <td>
              <input type="text" name="system.appearance" value="{{system.appearance}}" placeholder="{{localize 'GAIA.Legado.AppearancePlaceholder'}}" />
            </td>
            <td>
              <input type="text" name="system.height" value="{{system.height}}" placeholder="{{localize 'GAIA.Legado.HeightPlaceholder'}}" />
            </td>
            <td>
              <input type="text" name="system.lifeExpectancy" value="{{system.lifeExpectancy}}" placeholder="{{localize 'GAIA.Legado.LifeExpectancyPlaceholder'}}" />
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="weapon-description-panel" style="margin-top: 15px;">
      <label class="description-title">{{localize "GAIA.Legado.Description"}}</label>
      <textarea name="system.description" class="weapon-description-textarea" placeholder="{{localize 'GAIA.Legado.DescriptionPlaceholder'}}">{{system.description}}</textarea>
    </div>

    <div class="legacy-abilities-section" style="margin-top: 20px;">
      <div class="section-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
        <h3 class="panel-main-title" style="margin: 0;">{{localize "GAIA.Legado.AbilitiesTitle"}}</h3>
        <button type="button" class="btn-add-ability" data-action="addLegacyAbility" title="{{localize 'GAIA.Legado.AddAbilityTitle'}}">
          <i class="fa-solid fa-plus"></i> {{localize "GAIA.Legado.AddAbilityBtn"}}
        </button>
      </div>

      {{#each system.legacyAbilities as |ability index|}}
        <div class="legacy-ability-card" style="border: 1px solid var(--color-border, #444); border-radius: 4px; padding: 10px; margin-bottom: 10px; background: rgba(0,0,0,0.15);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <input type="text" name="system.legacyAbilities.{{index}}.name" value="{{ability.name}}" placeholder="{{localize 'GAIA.Legado.AbilityNamePlaceholder'}}" style="font-weight: bold; width: 80%;" />
            <button type="button" class="btn-remove-ability" data-action="removeLegacyAbility" data-index="{{index}}" title="{{localize 'GAIA.Legado.RemoveAbilityTitle'}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
          
          <div style="margin-bottom: 8px;">
            <label style="font-size: 0.85em; font-weight: bold;">{{localize "GAIA.Legado.AbilityDescriptionLabel"}}:</label>
            <textarea name="system.legacyAbilities.{{index}}.description" rows="2" placeholder="{{localize 'GAIA.Legado.AbilityDescriptionPlaceholder'}}" style="width: 100%; font-size: 0.9em;">{{ability.description}}</textarea>
          </div>

          <div>
            <label style="font-size: 0.85em; font-weight: bold; color: var(--color-highlight, #e67e22);">{{localize "GAIA.Legado.ActiveEffectLabel"}}:</label>
            <textarea name="system.legacyAbilities.{{index}}.activeEffect.text" rows="2" placeholder="{{localize 'GAIA.Legado.ActiveEffectPlaceholder'}}" style="width: 100%; font-size: 0.9em;">{{#if ability.activeEffect.text}}{{ability.activeEffect.text}}{{else}}{{ability.activeEffect}}{{/if}}</textarea>
          </div>
        </div>
      {{else}}
        <p class="empty-hint" style="font-style: italic; color: #888;">{{localize "GAIA.Legado.EmptyAbilitiesHint"}}</p>
      {{/each}}
    </div>
  </div>
</section>
