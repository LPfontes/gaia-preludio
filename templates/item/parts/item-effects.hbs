{{!-- ==============================================================================
     GAIA: PRELÚDIO - ITEM EFFECTS PARTIAL / PARCIAL DE EFEITOS DO ITEM
     ==============================================================================
     PT: Renderiza lista unificada de Efeitos configurados no Item.
     EN: Renders unified list of Effects configured on the Item. --}}

<div class="item-effects-panel">
  <div class="effects-section-header">
    <h4 class="effects-main-title">
      {{localize "GAIA.Effects.ItemEffectsTitle"}}
    </h4>
    <button type="button" class="btn-add-effect" data-action="createEffect" title="{{localize 'GAIA.Effects.AddEffect'}}">
      <i class="fa-solid fa-plus"></i> {{localize "GAIA.Effects.AddEffect"}}
    </button>
  </div>

  <div class="effects-list">
    {{#each effects.entries}}
    <div class="effect-card {{#if this.disabled}}inactive-effect-item{{else}}active-effect-item{{/if}}" data-effect-id="{{this.id}}">
      <div class="effect-card-main">
        <img class="effect-icon {{#if this.disabled}}grayscale{{/if}}" src="{{this.img}}" alt="{{this.name}}" />
        <div class="effect-details">
          <div class="effect-name-row">
            <strong class="effect-name {{#if this.disabled}}text-muted{{/if}}">{{this.name}}</strong>
            {{#if this.disabled}}
              <span class="badge badge-inactive">{{localize "GAIA.Effects.InactiveBadge"}}</span>
            {{/if}}
            {{#if this.durationText}}
              <span class="effect-duration-badge"><i class="fa-solid fa-hourglass-half"></i> {{this.durationText}}</span>
            {{/if}}
          </div>
          {{#if this.changes}}
          <div class="effect-changes-summary {{#if this.disabled}}text-muted{{/if}}">{{this.changes}}</div>
          {{/if}}
        </div>
      </div>

      <div class="effect-card-controls">
        <button type="button" class="btn-effect-control btn-toggle-effect" data-action="toggleEffect" data-effect-id="{{this.id}}" title="{{localize 'GAIA.Effects.ToggleEffect'}}">
          {{#if this.disabled}}
            <i class="fa-solid fa-toggle-off text-muted"></i>
          {{else}}
            <i class="fa-solid fa-toggle-on text-success"></i>
          {{/if}}
        </button>
        <button type="button" class="btn-effect-control btn-edit-effect" data-action="editEffect" data-effect-id="{{this.id}}" title="{{localize 'GAIA.Effects.EditEffect'}}">
          <i class="fa-solid fa-pen-to-square"></i>
        </button>
        <button type="button" class="btn-effect-control btn-delete-effect" data-action="deleteEffect" data-effect-id="{{this.id}}" title="{{localize 'GAIA.Effects.DeleteEffect'}}">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
    </div>
    {{else}}
    <div class="effects-empty-hint">{{localize "GAIA.Effects.NoActiveItemEffects"}}</div>
    {{/each}}
  </div>
</div>
