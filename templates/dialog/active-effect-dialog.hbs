<form class="gaia-dialog gaia-dialog-active-effect">
  <div class="form-group">
    <label>
      {{localize "GAIA.Dialog.ActiveEffectTextLabel"}}
    </label>
    <textarea name="text" rows="2" placeholder="{{localize 'GAIA.Dialog.ActiveEffectTextPlaceholder'}}">{{text}}</textarea>
  </div>

  <div class="form-group">
    <label>
      {{localize "GAIA.Dialog.RechargeLabel"}}
    </label>
    <select name="recharge">
      <option value="full_rest" {{#if (eq recharge "full_rest")}}selected{{/if}}>{{localize "GAIA.Recharge.FullRest"}}</option>
      <option value="short_rest" {{#if (eq recharge "short_rest")}}selected{{/if}}>{{localize "GAIA.Recharge.ShortRest"}}</option>
      <option value="encounter" {{#if (eq recharge "encounter")}}selected{{/if}}>{{localize "GAIA.Recharge.Encounter"}}</option>
      <option value="turn" {{#if (eq recharge "turn")}}selected{{/if}}>{{localize "GAIA.Recharge.Turn"}}</option>
    </select>
  </div>

  <div class="form-group">
    <label>
      {{localize "GAIA.Dialog.TriggerLabel"}}
    </label>
    <select name="triggerEvent">
      <option value="hp_threshold" {{#if (eq triggerEvent "hp_threshold")}}selected{{/if}}>{{localize "GAIA.Trigger.HpThreshold"}}</option>
      <option value="on_attack" {{#if (eq triggerEvent "on_attack")}}selected{{/if}}>{{localize "GAIA.Trigger.OnAttack"}}</option>
      <option value="on_damage" {{#if (eq triggerEvent "on_damage")}}selected{{/if}}>{{localize "GAIA.Trigger.OnDamage"}}</option>
      <option value="action" {{#if (eq triggerEvent "action")}}selected{{/if}}>{{localize "GAIA.Trigger.Action"}}</option>
      <option value="manual" {{#if (eq triggerEvent "manual")}}selected{{/if}}>{{localize "GAIA.Trigger.Manual"}}</option>
    </select>
  </div>

  <div class="form-group">
    <label>
      {{localize "GAIA.Dialog.HpThresholdPercentageLabel"}}
    </label>
    <input type="number" name="hpThresholdPercentage" value="{{hpThresholdPercentage}}" min="1" max="100" />
  </div>

  <div class="form-group checkbox-group">
    <label>
      <input type="checkbox" name="inCombatOnly" {{#if inCombatOnly}}checked{{/if}} />
      <span>{{localize "GAIA.Dialog.InCombatOnlyLabel"}}</span>
    </label>
  </div>

  <hr style="border-color: var(--gaia-border-subtle); margin: 8px 0;" />

  <div class="form-group">
    <label>
      {{localize "GAIA.Dialog.ChangeKeyLabel"}}
    </label>
    <select name="changeKey">
      <option value="all_parameters" {{#if (eq changeKey "all_parameters")}}selected{{/if}}>{{localize "GAIA.ChangeKey.AllParameters"}}</option>
      <option value="movement" {{#if (eq changeKey "movement")}}selected{{/if}}>{{localize "GAIA.ChangeKey.Movement"}}</option>
      <option value="health" {{#if (eq changeKey "health")}}selected{{/if}}>{{localize "GAIA.ChangeKey.Health"}}</option>
      <option value="block" {{#if (eq changeKey "block")}}selected{{/if}}>{{localize "GAIA.ChangeKey.Block"}}</option>
    </select>
  </div>

  <div class="form-group">
    <label>
      {{localize "GAIA.Dialog.ChangeValueLabel"}}
    </label>
    <input type="number" name="changeValue" value="{{changeValue}}" />
  </div>

  <div class="form-group">
    <label>
      {{localize "GAIA.Dialog.DurationTypeLabel"}}
    </label>
    <select name="durationType">
      <option value="end_of_combat" {{#if (eq durationType "end_of_combat")}}selected{{/if}}>{{localize "GAIA.Duration.EndOfCombat"}}</option>
      <option value="1_round" {{#if (eq durationType "1_round")}}selected{{/if}}>{{localize "GAIA.Duration.OneRound"}}</option>
      <option value="1_turn" {{#if (eq durationType "1_turn")}}selected{{/if}}>{{localize "GAIA.Duration.OneTurn"}}</option>
      <option value="instant" {{#if (eq durationType "instant")}}selected{{/if}}>{{localize "GAIA.Duration.Instant"}}</option>
      <option value="permanent" {{#if (eq durationType "permanent")}}selected{{/if}}>{{localize "GAIA.Duration.Permanent"}}</option>
    </select>
  </div>
</form>
