<section class="gaia-sheet-content gaia-ability-sheet">
  <form class="gaia-dialog gaia-dialog-legacy-ability gaia-ability-card">
    
    <!-- CABEÇALHO DA CARTA DE HABILIDADE -->
    <div class="ability-card-header">
      <div class="ability-title-row">
        <i class="fas fa-crown ability-icon" style="display: flex; align-items: center; justify-content: center; font-size: 24px; color: var(--gaia-gold); text-shadow: 1px 1px 2px #000;" title="{{localize 'GAIA.Legado.AbilityNameLabel'}}"></i>
        <h2 class="ability-name">
          <input name="name" type="text" value="{{name}}" placeholder="{{localize 'GAIA.Legado.AbilityNamePlaceholder'}}" required autofocus />
        </h2>
      </div>
    </div>

    <!-- NAVEGAÇÃO PRINCIPAL -->
    <nav class="sheet-navigation-tabs item-tabs tabs ability-navigation-tabs" data-group="primary">
      <a class="tab-item active" data-action="tab" data-group="primary" data-tab="tabela">Tabela</a>
      <a class="tab-item" data-action="tab" data-group="primary" data-tab="acoes">Ações</a>
      <a class="tab-item" data-action="tab" data-group="primary" data-tab="efeitos">Efeitos</a>
    </nav>

    <!-- CORPO DA HABILIDADE -->
    <div class="ability-card-body">
      <section class="sheet-tabs-content item-tabs-content" style="padding-top: 10px;">
        <!-- ABA TABELA (DESCRIÇÃO) -->
        <div class="tab tabela active" data-group="primary" data-tab="tabela">
          <div class="ability-main-description">
            <textarea name="description" placeholder="{{localize 'GAIA.Legado.AbilityDescriptionPlaceholder'}}" style="min-height: 120px;">{{description}}</textarea>
          </div>
        </div>

        <!-- ABA AÇÕES -->
        <div class="tab acoes" data-group="primary" data-tab="acoes">
          <div class="ability-subeffects-container">
            <div class="subeffects-header">
              <span class="subeffects-title">{{localize "GAIA.Action.SectionTitle"}}</span>
              <button type="button" class="btn-add-action btn-add-subeffect" data-action="addLegacyAction" title="{{localize 'GAIA.Action.AddActionBtn'}}">
                <i class="fas fa-plus"></i> {{localize "GAIA.Action.AddActionBtn"}}
              </button>
            </div>
            
            <div class="legacy-actions-preview-list" style="display: flex; flex-direction: column; gap: 4px; margin-top: 8px;">
              {{#each formattedActions}}
              <div class="subeffect-card legacy-action-preview-item" data-index="{{@index}}" style="cursor: default;">
                <div class="subeffect-card-header">
                  <div class="subeffect-identity">
                    <strong class="subeffect-title-text">{{this.name}}</strong>
                    {{#if this.summary}}
                    <div class="subeffect-meta-badges">
                      <span class="subeffect-meta-badge type-badge">{{this.summary}}</span>
                    </div>
                    {{/if}}
                  </div>
                  <div class="subeffect-controls">
                    <button type="button" class="btn-edit-dialog-action" data-index="{{@index}}" title="Editar Ação">
                      <i class="fas fa-pen-to-square"></i>
                    </button>
                    <button type="button" class="btn-remove-dialog-action" data-index="{{@index}}" title="Remover Ação">
                      <i class="fas fa-trash"></i>
                    </button>
                  </div>
                </div>
              </div>
              {{else}}
              <div class="empty-hint" style="font-size: 12px; font-style: italic; color: var(--gaia-text-muted); text-align: center; padding: 10px;">
                {{localize "GAIA.Action.EmptyActionsHint"}}
              </div>
              {{/each}}
            </div>
          </div>
        </div>

        <!-- ABA EFEITOS -->
        <div class="tab efeitos" data-group="primary" data-tab="efeitos">
          <div class="item-effects-panel">
            <div class="effects-section-header">
              <span class="effects-main-title">Efeito Ativo</span>
              <button type="button" class="btn-add-effect" data-action="createEffect" title="Criar Efeito Ativo">
                <i class="fas fa-plus"></i>
              </button>
            </div>
            <textarea name="activeEffectText" rows="3" placeholder="{{localize 'GAIA.Legado.EmptyActiveEffectHint'}}" style="width: 100%; background: transparent; color: var(--gaia-text-primary); border-radius: var(--gaia-radius); padding: 5px; border: 1px solid #dcd6e8; font-family: inherit; resize: vertical;">{{activeEffectText}}</textarea>
          </div>
        </div>
      </section>
    </div>

  </form>
</section>