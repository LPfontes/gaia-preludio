<div class="gaia-dialog-awakening-guide">
  {{!-- Caixa introdutória e Seletor de Modo (Desperto vs Não-Desperto) --}}
  <div class="gaia-dialog-intro-box">
    <div class="awakening-mode-selection">
      <label class="awakening-mode-label">
        <i class="fa-solid fa-user-shield"></i> {{localize "GAIA.CreateActor.ModeSelectLabel"}}
      </label>
      <div class="awakening-mode-options">
        <label class="awakening-mode-option">
          <input type="radio" name="creationMode" value="awakened" checked class="creation-mode-radio" />
          <strong>{{localize "GAIA.CreateActor.ModeAwakened"}}</strong>
        </label>
        <label class="awakening-mode-option">
          <input type="radio" name="creationMode" value="unawakened" class="creation-mode-radio" />
          <strong>{{localize "GAIA.CreateActor.ModeUnawakened"}}</strong>
        </label>
      </div>
    </div>
    <p class="gaia-intro-description-text">
      {{localize "GAIA.CreateActor.AwakeningIntro"}}
    </p>
  </div>

  {{!-- Barra de navegação por abas --}}
  <nav class="gaia-dialog-tabs">
    <button type="button" class="gaia-dialog-tab-btn active" data-tab="legacy">
      {{localize "GAIA.CreateActor.TabLegacy"}}
    </button>
    <button type="button" class="gaia-dialog-tab-btn" data-tab="parameters">
      {{localize "GAIA.CreateActor.TabParameters"}}
    </button>
    <button type="button" class="gaia-dialog-tab-btn" data-tab="knowledge">
      {{localize "GAIA.CreateActor.TabKnowledge"}}
    </button>
    <button type="button" class="gaia-dialog-tab-btn" data-tab="vitals">
      {{localize "GAIA.CreateActor.TabVitals"}}
    </button>
    <button type="button" class="gaia-dialog-tab-btn" data-tab="abilities">
      {{localize "GAIA.CreateActor.TabAbilities"}}
    </button>
  </nav>

  {{!-- Conteúdo das abas --}}
  <div class="gaia-dialog-tab-body">
    {{!-- ==================================================================== --}}
    {{!-- ETAPA 1: LEGADO --}}
    {{!-- ==================================================================== --}}
    <div class="gaia-dialog-tab-pane active" data-tab="legacy">
      <p class="gaia-dialog-hint-title">
        <i class="fa-solid fa-feather-pointed"></i> {{localize "GAIA.CreateActor.AwakeningLegacyTitle"}}
      </p>
      <p class="gaia-dialog-hint-text">
        ● {{localize "GAIA.CreateActor.AwakeningLegacyHint"}}
      </p>

      {{!-- Linha de Seleção do Legado --}}
      <div class="awakening-legacy-select-row">
        <select class="gaia-awakening-legacy-select" name="selectedLegacyUuid">
          <option value="">-- {{localize "GAIA.CreateActor.SelectLegacy"}} --</option>
          {{#each availableLegacies as |leg|}}
            <option value="{{leg.uuid}}" {{#if leg.isSelected}}selected{{/if}} data-name="{{leg.name}}">
              {{leg.name}}{{#if leg.sourceLabel}} ({{leg.sourceLabel}}){{/if}}
            </option>
          {{/each}}
          <option value="__custom__" {{#if isCustomLegacy}}selected{{/if}}>
            {{localize "GAIA.CreateActor.CustomLegacyOption"}}
          </option>
        </select>
        <button type="button" class="gaia-hp-action-btn btn-open-legacy-browser" title="Abrir Navegador de Itens para explorar e selecionar o Legado">
          <i class="fa-solid fa-book-open"></i> {{localize "GAIA.CreateActor.OpenLegacyBrowser"}}
        </button>
      </div>

      {{!-- Campo para Legado Personalizado --}}
      <div class="awakening-custom-legacy-box" style="{{#if isCustomLegacy}}display: flex;{{else}}display: none;{{/if}}">
        <input type="text" class="gaia-awakening-custom-legacy-input" placeholder="{{localize 'GAIA.CreateActor.CustomLegacyPlaceholder'}}" value="{{customLegacyName}}" />
      </div>

      {{!-- Card de Detalhes / Pré-visualização do Legado Selecionado --}}
      <div class="awakening-legacy-preview-container">
        {{#if selectedLegacyData}}
          <div class="awakening-legacy-preview-card">
            <div class="awakening-legacy-header">
              <img src="{{selectedLegacyData.img}}" class="awakening-legacy-img" alt="{{selectedLegacyData.name}}" />
              <div class="awakening-legacy-title-group">
                <span class="awakening-legacy-name">{{selectedLegacyData.name}}</span>
                <div class="awakening-legacy-tags">
                  {{#if selectedLegacyData.height}}
                    <span class="awakening-legacy-tag" title="{{localize 'GAIA.CreateActor.LegacyHeight'}}">
                      <i class="fa-solid fa-ruler-vertical"></i> {{selectedLegacyData.height}}
                    </span>
                  {{/if}}
                  {{#if selectedLegacyData.lifeExpectancy}}
                    <span class="awakening-legacy-tag" title="{{localize 'GAIA.CreateActor.LegacyLifeExpectancy'}}">
                      <i class="fa-solid fa-hourglass-half"></i> {{selectedLegacyData.lifeExpectancy}}
                    </span>
                  {{/if}}
                </div>
              </div>
            </div>

            {{#if (or selectedLegacyData.appearance selectedLegacyData.origin selectedLegacyData.traditions selectedLegacyData.inWorld)}}
            <div class="awakening-legacy-bio-grid">
              {{#if selectedLegacyData.appearance}}
                <div class="awakening-legacy-bio-item">
                  <span class="awakening-legacy-bio-label"><i class="fa-solid fa-eye"></i> {{localize "GAIA.Legado.Appearance"}}</span>
                  <span class="awakening-legacy-bio-val">{{selectedLegacyData.appearance}}</span>
                </div>
              {{/if}}
              {{#if selectedLegacyData.origin}}
                <div class="awakening-legacy-bio-item">
                  <span class="awakening-legacy-bio-label"><i class="fa-solid fa-landmark"></i> {{localize "GAIA.Legado.Origin"}}</span>
                  <span class="awakening-legacy-bio-val">{{selectedLegacyData.origin}}</span>
                </div>
              {{/if}}
              {{#if selectedLegacyData.traditions}}
                <div class="awakening-legacy-bio-item">
                  <span class="awakening-legacy-bio-label"><i class="fa-solid fa-scroll"></i> {{localize "GAIA.Legado.Traditions"}}</span>
                  <span class="awakening-legacy-bio-val">{{selectedLegacyData.traditions}}</span>
                </div>
              {{/if}}
              {{#if selectedLegacyData.inWorld}}
                <div class="awakening-legacy-bio-item">
                  <span class="awakening-legacy-bio-label"><i class="fa-solid fa-earth-americas"></i> {{localize "GAIA.Legado.InWorld"}}</span>
                  <span class="awakening-legacy-bio-val">{{selectedLegacyData.inWorld}}</span>
                </div>
              {{/if}}
            </div>
            {{/if}}

            {{#if selectedLegacyData.legacyAbilities.length}}
              <div class="awakening-legacy-abilities-section">
                <span class="awakening-legacy-abilities-title">
                  <i class="fa-solid fa-crown"></i> {{localize "GAIA.CreateActor.LegacyAbilities"}} ({{selectedLegacyData.legacyAbilities.length}})
                </span>
                <div class="awakening-legacy-abilities-list">
                  {{#each selectedLegacyData.legacyAbilities as |ab|}}
                    <div class="awakening-legacy-ability-item">
                      <span class="awakening-legacy-ability-name">
                        <i class="fa-solid fa-feather-pointed"></i> {{ab.name}}
                      </span>
                      {{#if ab.description}}
                        <span class="awakening-legacy-ability-desc">{{{ab.description}}}</span>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
              </div>
            {{/if}}
          </div>
        {{else}}
          <div class="empty-abilities-hint gaia-dialog-hint-muted awakening-legacy-empty-hint">
            {{localize "GAIA.CreateActor.EmptyLegacyHint"}}
          </div>
        {{/if}}
      </div>

      <div class="gaia-dialog-tab-footer">
        <button type="button" class="gaia-wizard-nav-btn" data-next-tab="parameters">
          <span>{{localize "GAIA.CreateActor.Next"}}</span> <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>

    {{!-- ==================================================================== --}}
    {{!-- ETAPA 2: PARÂMETROS --}}
    {{!-- ==================================================================== --}}
    <div class="gaia-dialog-tab-pane" data-tab="parameters">
      <p class="gaia-dialog-hint-title">
        {{localize "GAIA.CreateActor.AwakeningParamTitle"}}
      </p>
      <p class="gaia-dialog-hint-text">
        ● {{localize "GAIA.CreateActor.AwakeningParam"}}
      </p>

      {{!-- Distribuidor Interativo dos Pontos de Parâmetros --}}
      <div class="gaia-distributor-header">
        <span class="gaia-distributor-title">
          {{localize "GAIA.CreateActor.PointsDistribute"}}
        </span>
        <span class="gaia-points-tracker">
          {{localize "GAIA.CreateActor.PointsRemaining"}} <strong class="gaia-points-left">7</strong> / <span
            class="gaia-param-max-points">7</span>
        </span>
      </div>

      <div class="gaia-params-dist-grid">
        {{#each parameters as |param|}}
        <div class="gaia-param-dist-card">
          <span class="gaia-param-dist-label">{{param.label}}</span>
          <div class="gaia-param-dist-controls">
            <button type="button" class="gaia-param-adjust-btn" data-action="decrease" data-param="{{param.key}}">
              <i class="fa-solid fa-minus"></i>
            </button>
            <input type="text" class="gaia-param-dist-input" data-param="{{param.key}}" value="{{param.value}}"
              readonly />
            <button type="button" class="gaia-param-adjust-btn" data-action="increase" data-param="{{param.key}}">
              <i class="fa-solid fa-plus"></i>
            </button>
          </div>
        </div>
        {{/each}}
      </div>

      <div class="gaia-dialog-tab-footer">
        <button type="button" class="gaia-wizard-nav-btn" data-next-tab="legacy">
          <i class="fa-solid fa-arrow-left"></i> <span>{{localize "GAIA.CreateActor.Previous"}}</span>
        </button>
        <button type="button" class="gaia-wizard-nav-btn" data-next-tab="knowledge">
          <span>{{localize "GAIA.CreateActor.Next"}}</span> <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>

    {{!-- ==================================================================== --}}
    {{!-- ETAPA 2: CONHECIMENTOS --}}
    {{!-- ==================================================================== --}}
    <div class="gaia-dialog-tab-pane" data-tab="knowledge">
      <p class="gaia-dialog-hint-title">
        {{localize "GAIA.CreateActor.AwakeningKnowledgeTitle"}}
      </p>
      <p class="gaia-dialog-hint-text">
        ● {{localize "GAIA.CreateActor.AwakeningKnowledge"}}
      </p>

      {{!-- Distribuidor Interativo dos 7 Pontos de Conhecimentos --}}
      <div class="gaia-distributor-header">
        <span class="gaia-distributor-title">
          {{localize "GAIA.CreateActor.PointsDistributeKnowledge"}}
        </span>
        <span class="gaia-points-tracker">
          {{localize "GAIA.CreateActor.PointsRemaining"}} <strong class="gaia-know-points-left">7</strong> / 7
        </span>
      </div>

      <div class="gaia-params-dist-grid">
        {{#each knowledge as |know|}}
        <div class="gaia-param-dist-card">
          <span class="gaia-param-dist-label">{{know.label}}</span>
          <div class="gaia-param-dist-controls">
            <button type="button" class="gaia-know-adjust-btn gaia-param-adjust-btn" data-action="decrease"
              data-knowledge="{{know.key}}">
              <i class="fa-solid fa-minus"></i>
            </button>
            <input type="text" class="gaia-know-dist-input gaia-param-dist-input" data-knowledge="{{know.key}}"
              value="{{know.value}}" readonly />
            <button type="button" class="gaia-know-adjust-btn gaia-param-adjust-btn" data-action="increase"
              data-knowledge="{{know.key}}">
              <i class="fa-solid fa-plus"></i>
            </button>
          </div>
        </div>
        {{/each}}
      </div>

      <div class="gaia-dialog-tab-footer">
        <button type="button" class="gaia-wizard-nav-btn" data-next-tab="parameters">
          <i class="fa-solid fa-arrow-left"></i> <span>{{localize "GAIA.CreateActor.Previous"}}</span>
        </button>
        <button type="button" class="gaia-wizard-nav-btn" data-next-tab="vitals">
          <span>{{localize "GAIA.CreateActor.Next"}}</span> <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>

    {{!-- ==================================================================== --}}
    {{!-- ETAPA 3: RECURSOS (VIDA & ENERGIA) E IDIOMAS --}}
    {{!-- ==================================================================== --}}
    <div class="gaia-dialog-tab-pane" data-tab="vitals">
      <p class="gaia-dialog-hint-title">
        {{localize "GAIA.CreateActor.AwakeningVitalsTitle"}}
      </p>

      {{!-- Painel específico para Personagem Desperto --}}
      <div class="vitals-panel-awakened">
        <ul class="gaia-dialog-hint-list">
          <li><strong>Pontos de Vida (PV):</strong> 30 + <span class="gaia-hp-die-val">{{hpDie}}</span> (ou <span class="gaia-hp-fixed-val">{{fixedHpBase}}</span>) + <span class="gaia-vigor-hint-val">0</span> (Vigor) <span class="badge badge-passive badge-fortitude" style="{{#unless isDwarf}}display: none;{{/unless}}" title="Fortitude Ampliada: 1d8 ou 4 fixo"><i class="fa-solid fa-shield-heart"></i> Fortitude Ampliada</span>
          </li>
          <li><strong>Pontos de Energia (PE):</strong> 5 PE Máx</li>
          <li><strong>Movimentação Base:</strong> 6m (+ bônus de Agilidade)</li>
        </ul>

        {{!-- Painel de Definição / Rolagem de Vida --}}
        <div class="gaia-vitals-roller-box">
          <div class="gaia-vitals-roller-header">
            <span class="gaia-distributor-title">
              <i class="fa-solid fa-heart-pulse"></i> {{localize "GAIA.CreateActor.RollHPHint"}}
            </span>
            <div class="gaia-vitals-roller-controls">
              <button type="button" class="gaia-hp-action-btn gaia-roll-hp-btn {{#if isDwarf}}active{{/if}}" data-action="roll">
                <i class="fa-solid {{hpDieIcon}} gaia-hp-roll-icon"></i> <span class="gaia-hp-roll-label">Rolar {{hpDie}}</span>
              </button>
              <button type="button" class="gaia-hp-action-btn gaia-fixed-hp-btn {{#unless isDwarf}}active{{/unless}}" data-action="fixed">
                <span class="gaia-hp-fixed-label">Fixo ({{fixedHpBase}})</span>
              </button>
            </div>
          </div>

          <div class="gaia-vitals-result-display">
            <span>{{localize "GAIA.CreateActor.CalculatedHP"}}</span>
            <strong class="gaia-vitals-calculated-hp">{{initialCalculatedHp}} PV</strong>
            <input type="hidden" class="gaia-hp-selected-input" value="{{initialCalculatedHp}}" />
          </div>
        </div>
      </div>

      {{!-- Painel específico para Personagem Não-Desperto --}}
      <div class="vitals-panel-unawakened" style="display: none;">
        <ul class="gaia-dialog-hint-list">
          <li><strong>Pontos de Vida (PV):</strong> 12 PV (Fixos)</li>
          <li><strong>Pontos de Energia (PE):</strong> 0 PE Máx</li>
          <li><strong>Movimentação Base:</strong> 6m</li>
        </ul>

        {{!-- Painel de Seleção de Idioma Adicional --}}
        <div class="gaia-vitals-roller-box unawakened-languages-box">
          <div class="gaia-vitals-roller-header">
            <span class="gaia-distributor-title">
              <i class="fa-solid fa-language"></i> {{localize "GAIA.CreateActor.AdditionalLanguage"}}
            </span>
          </div>

          <p class="gaia-dialog-hint-text">
            ● <strong>Comum</strong> (incluso automaticamente) + 1 outro idioma à escolha:
          </p>

          <select class="unawakened-additional-language-select">
            <option value="">-- {{localize "GAIA.CreateActor.SelectAdditionalLanguage"}} --</option>
            {{#each availableLanguages as |lang|}}
            <option value="{{lang.key}}">{{lang.label}} ({{lang.categoryLabel}})</option>
            {{/each}}
          </select>
        </div>

        <p class="gaia-dialog-hint-muted">
          Um ser Não-Desperto não canalizou o Véu e mantém apenas suas Habilidades de Legado naturais.
        </p>
      </div>

      <div class="gaia-dialog-tab-footer">
        <button type="button" class="gaia-wizard-nav-btn" data-next-tab="knowledge">
          <i class="fa-solid fa-arrow-left"></i> <span>{{localize "GAIA.CreateActor.Previous"}}</span>
        </button>
        <button type="button" class="gaia-wizard-nav-btn" data-next-tab="abilities">
          <span>{{localize "GAIA.CreateActor.Next"}}</span> <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>

    {{!-- ==================================================================== --}}
    {{!-- ETAPA 4: HABILIDADES DE CAMINHO --}}
    {{!-- ==================================================================== --}}
    <div class="gaia-dialog-tab-pane" data-tab="abilities">
      <p class="gaia-dialog-hint-title">
        {{localize "GAIA.CreateActor.AwakeningAbilitiesTitle"}}
      </p>
      <p class="gaia-dialog-hint-text">
        ● {{localize "GAIA.CreateActor.AwakeningAbilitiesHint"}}
      </p>

      {{!-- Painel específico para Personagem Desperto --}}
      <div class="abilities-panel-awakened">
        <div class="gaia-vitals-roller-box gaia-abilities-selection-box">
          <div class="gaia-vitals-roller-header">
            <span class="gaia-distributor-title">
              <i class="fa-solid fa-book-sparkles"></i> {{localize "GAIA.CreateActor.ChooseAbilitiesTitle"}}
            </span>
            <div class="gaia-vitals-roller-controls">
              <button type="button" class="gaia-hp-action-btn btn-open-abilities-browser">
                <i class="fa-solid fa-book-open"></i> {{localize "GAIA.CreateActor.OpenAbilitiesBrowser"}}
              </button>
            </div>
          </div>

          <div class="awakening-chosen-abilities-container">
            <div class="awakening-chosen-abilities-header">
              <span class="gaia-distributor-title awakening-chosen-title">
                <i class="fa-solid fa-list-check"></i> {{localize "GAIA.CreateActor.SelectedAbilitiesLabel"}}
              </span>
              <span class="gaia-points-tracker">
                <strong class="awakening-selected-abilities-count">{{initialAbilities.length}}</strong> / 2
              </span>
            </div>

            <div class="awakening-chosen-abilities-list">
              {{#if initialAbilities.length}}
                {{#each initialAbilities as |ab idx|}}
                <div class="awakening-ability-card" data-index="{{@index}}">
                  <div class="awakening-ability-info">
                    <img src="{{ab.img}}" class="awakening-ability-img" alt="{{ab.name}}" />
                    <div class="awakening-ability-text">
                      <strong class="awakening-ability-name">{{ab.name}}</strong>
                      {{#if ab.category}}<span class="awakening-ability-category">{{ab.category}}</span>{{/if}}
                    </div>
                  </div>
                  <button type="button" class="btn-remove-chosen-ability" data-index="{{@index}}" title="Remover Habilidade">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
                {{/each}}
              {{else}}
                <div class="empty-abilities-hint gaia-dialog-hint-muted">
                  {{localize "GAIA.CreateActor.EmptyAbilitiesHint"}}
                </div>
              {{/if}}
            </div>
          </div>
        </div>
      </div>

      {{!-- Painel específico para Personagem Não-Desperto --}}
      <div class="abilities-panel-unawakened" style="display: none;">
        <div class="gaia-vitals-roller-box">
          <p class="gaia-dialog-hint-muted">
            <i class="fa-solid fa-circle-info"></i> {{localize "GAIA.CreateActor.UnawakenedNoAbilities"}}
          </p>
        </div>
      </div>

      <div class="gaia-dialog-tab-footer">
        <button type="button" class="gaia-wizard-nav-btn" data-next-tab="vitals">
          <i class="fa-solid fa-arrow-left"></i> <span>{{localize "GAIA.CreateActor.Previous"}}</span>
        </button>
      </div>
    </div>
  </div>
</div>