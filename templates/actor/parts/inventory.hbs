<div class="inventory-column-container">

  {{!-- 1. TABELA DE ARMAS --}}
  <div class="inventory-table-panel tab-weapons-content">
    <div class="inventory-table-header">
      <h4 class="inventory-table-title">
        {{localize "GAIA.Inventory.Weapons"}}
      </h4>
      <button type="button" class="btn-add-item" data-action="createItem" data-type="weapon" data-category="weapon" title="{{localize 'GAIA.Inventory.AddWeapon'}}">
        <i class="fa-solid fa-plus"></i>
      </button>
    </div>
    <div class="weapons-table-frame">
      <table class="inventory-grid-table">
        <thead>
          <tr>
            <th class="col-item-name">{{localize "GAIA.TableLabels.WeaponName"}}</th>
            <th class="col-item-stat">{{localize "GAIA.TableLabels.WeaponDamage"}}</th>
            <th class="col-item-range">{{localize "GAIA.TableLabels.WeaponRange"}}</th>
            <th class="col-item-props">{{localize "GAIA.TableLabels.WeaponProperties"}}</th>
            <th class="col-item-qty">{{localize "GAIA.TableLabels.Quantity"}}</th>
            <th class="col-item-unity">{{localize "GAIA.TableLabels.Unity"}}</th>
            <th class="col-item-actions">{{localize "GAIA.TableLabels.Actions"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each (or inventoryWeapons weapons) as |weapon|}}
            <tr class="item-row weapon-row" data-item-id="{{weapon.id}}">
              <td class="col-item-name" data-action="openItem" data-item-id="{{weapon.id}}" role="button" title="{{localize 'GAIA.title.ClickToOpenDetailsOf' weapon.name}}">
                <div class="item-name-cell">
                  {{#if weapon.img}}
                    <img class="item-mini-icon" src="{{weapon.img}}" alt="{{weapon.name}}" />
                  {{/if}}
                  <span class="item-name-text">{{weapon.name}}</span>
                </div>
              </td>
              <td class="col-item-stat">{{weapon.damage}}</td>
              <td class="col-item-range">{{weapon.range}}</td>
              <td class="col-item-props">{{weapon.properties}}</td>
              <td class="col-item-qty">{{weapon.quantity}}</td>
              <td class="col-item-unity">{{weapon.unity}}</td>
              <td class="col-item-actions">
                <button type="button" class="btn-item-action {{#if weapon.equipped}}equipped{{/if}}" data-action="toggleEquip" data-item-id="{{weapon.id}}" title="{{#if weapon.equipped}}{{localize 'GAIA.title.Unequip'}}{{else}}{{localize 'GAIA.title.Equip'}}{{/if}}">
                  <i class="fa-solid fa-shield-halved"></i>
                </button>
                <button type="button" class="btn-item-action" data-action="openItem" data-item-id="{{weapon.id}}" title="{{localize 'GAIA.title.EditItem'}}">
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button type="button" class="btn-item-action danger" data-action="deleteItem" data-item-id="{{weapon.id}}" title="{{localize 'GAIA.title.DeleteItem'}}">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </td>
            </tr>
          {{else}}
            <tr class="empty-row">
              <td colspan="7" class="empty-cell">{{localize "GAIA.Inventory.EmptyWeapons"}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

