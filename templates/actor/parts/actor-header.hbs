<div class="gaia-actor-banner">
  {{!-- 1. Nome e Nível --}}
  <div class="banner-top-row">
    <div class="banner-field-card name-field">
      <span class="field-label">{{localize "GAIA.Banner.Name"}}</span>
      <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'GAIA.Banner.CharacterNamePlaceholder'}}" />
    </div>

    <div class="banner-field-card level-field">
      <span class="field-label">{{localize "GAIA.Banner.Level"}}</span>
      <div class="level-input-container" style="display: flex; align-items: center; gap: 4px; width: 100%;">
        <input type="number" name="system.nivel" value="{{system.nivel}}" min="1" style="flex: 1;" />
        <button type="button" class="btn-level-up" data-action="levelUp" title="Evolução do Despertar (Subir de Nível)" style="background: transparent; border: none; color: var(--gaia-gold-accent, #c9a34b); cursor: pointer; padding: 2px 4px; font-size: 14px; display: flex; align-items: center; justify-content: center;">
          <i class="fa-solid fa-arrow-up-from-bracket"></i>
        </button>
      </div>
    </div>
  </div>

  {{!-- 2. Legado / Legacy --}}
  <div class="banner-mid-row">
    <div class="banner-field-card legacy-field legado-field">
      <span class="field-label">{{localize "GAIA.Banner.Legacy"}}</span>
      <div class="legacy-select-container" style="display: flex; align-items: center; gap: 4px; width: 100%;">
        <select name="system.legacy" style="flex: 1;">
          {{selectOptions legacySelectOptions selected=system.legacy blank=""}}
        </select>
        {{#if legacyItem}}
          <button type="button" class="btn-open-legacy-sheet" data-action="openLegacyItem" data-item-id="{{legacyItem.id}}" data-item-uuid="{{legacyItem.uuid}}" title="Abrir Ficha do Legado ({{legacyItem.name}})" style="background: transparent; border: none; color: var(--gaia-border-gold, #8c7355); cursor: pointer; padding: 2px 4px; font-size: 14px;">
            <i class="fa-solid fa-feather-pointed"></i>
          </button>
        {{/if}}
      </div>
    </div>
  </div>

  {{!-- 3. Vida (Atual / Max) --}}
  <div class="resource-card health-card">
    <span class="resource-title">{{localize "GAIA.Banner.Health"}}</span>
    <div class="resource-inputs-row">
      <div class="stat-input-box">
        <span class="input-sublabel">{{localize "GAIA.Banner.Current"}}</span>
        <input type="number" name="system.health.value" value="{{system.health.value}}" min="0" />
      </div>
      <div class="stat-input-box" data-tooltip="{{tooltips.healthMax}}" title="{{tooltips.healthMax}}">
        <span class="input-sublabel">{{localize "GAIA.Banner.Max"}}</span>
        <input type="number" name="system.health.max" value="{{system.health.max}}" min="0" />
      </div>
      <div class="stat-input-box">
        <span class="input-sublabel">{{localize "GAIA.Banner.TempHP"}}</span>
        <input type="number" name="system.health.temp" value="{{system.health.temp}}" min="0" />
      </div>
    </div>
  </div>

  {{!-- 4. Energia (Atual / Max / PET) --}}
  <div class="resource-card energy-card">
    <span class="resource-title">{{localize "GAIA.Banner.Energy"}}</span>
    <div class="resource-inputs-row">
      <div class="stat-input-box">
        <span class="input-sublabel">{{localize "GAIA.Banner.Current"}}</span>
        <input type="number" name="system.energy.value" value="{{system.energy.value}}" min="0" />
      </div>
      <div class="stat-input-box">
        <span class="input-sublabel">{{localize "GAIA.Banner.Max"}}</span>
        <input type="number" name="system.energy.max" value="{{system.energy.max}}" min="0" />
      </div>
      <div class="stat-input-box">
        <span class="input-sublabel">{{localize "GAIA.Banner.TempEnergy"}}</span>
        <input type="number" name="system.energy.temp" value="{{system.energy.temp}}" min="0" />
      </div>
    </div>
  </div>

  {{!-- 5. Escudos de Defesa: Bloqueio e Agilidade --}}
  <div class="shields-column">
    <span class="shield-title">{{localize "GAIA.Banner.DefenseTitle"}}</span>
    <div class="shields-container"> 
      {{!-- Bloqueio --}}
      <div class="shield-card" 
          data-action="rollDefense" 
          data-type="block" 
          data-context-action="editField" 
          data-field="system.block" 
          data-label="{{localize 'GAIA.Banner.Block'}}" 
          data-type-input="number" 
          data-min="0" 
          role="button" 
          data-tooltip="{{tooltips.block}}"
          title="{{tooltips.block}}&#10;Clique esquerdo: Rolar Defesa | Clique direito: Alterar Bloqueio">
        <div class="shield-frame">
          <div class="shield-content">
            <span class="shield-title">{{localize "GAIA.Banner.Block"}}</span>
            <span class="shield-input">{{#if system.totalBlock}}{{system.totalBlock}}{{else}}{{system.block}}{{/if}}</span>
          </div>
        </div>
      </div>

      {{!-- Agilidade --}}
      <div class="shield-card" 
          data-action="rollDefense" 
          data-type="agility" 
          data-context-action="editField" 
          data-field="parameter.agility" 
          data-label="{{localize 'GAIA.Banner.Agility'}}" 
          data-type-input="number" 
          data-min="0" 
          data-max="6" 
          role="button" 
          title="Clique esquerdo: Rolar Defesa | Clique direito: Alterar Agilidade">
        <div class="shield-frame">
          <div class="shield-content">
            <span class="shield-title">{{localize "GAIA.Banner.Agility"}}</span>
            <span class="shield-value">{{agilityValue}}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{!-- 6. Movimento e Iniciativa --}}
  <div class="move-init-row">
    {{!-- Movimento --}}
    <div class="move-card" 
         data-context-action="editField" 
         data-field="system.movement" 
         data-label="{{localize 'GAIA.Banner.Movement'}}" 
         data-type-input="number" 
         data-min="0" 
         role="button" 
         data-tooltip="{{tooltips.movement}}"
         title="{{tooltips.movement}}&#10;Clique com botão direito para Alterar Movimento">
      <span class="banner-title">{{localize "GAIA.Banner.Movement"}}</span>
      <span class="banner-input">{{#if (ne system.totalMovement undefined)}}{{system.totalMovement}}{{else}}{{system.movement}}{{/if}}</span>
    </div>

    {{!-- Iniciativa --}}
    <div class="init-card" 
         data-action="rollInitiative" 
         data-context-action="editField" 
         data-field="parameter.agility" 
         data-label="{{localize 'GAIA.Banner.Initiative'}} ({{localize 'GAIA.Banner.Agility'}})" 
         data-type-input="number" 
         data-min="0" 
         data-max="6" 
         role="button" 
         title="Clique esquerdo: Rolar Iniciativa | Clique direito: Alterar Agilidade">
      <span class="banner-title">{{localize "GAIA.Banner.Initiative"}}</span>
      <span class="init-value">{{initiativeValue}}</span>
      <span class="init-sub">({{localize "GAIA.Banner.Agility"}})</span>
    </div>
  </div>

  {{!-- 7. Exaustão (6 Pips com Morte no 6º) --}}
  <div class="exhaustion-card {{#if isDeadByExhaustion}}dead-state{{/if}}" data-tooltip="{{tooltips.exhaustion}}" title="{{tooltips.exhaustion}}">
    <div class="exhaustion-header-row">
      <span class="exhaustion-title">{{localize "GAIA.Banner.Exhaustion"}}</span>
      {{#if isDeadByExhaustion}}
        <span class="exhaustion-dead-badge" title="Personagem morto por atingir 6 pontos de exaustão">
          {{localize "GAIA.Banner.ExhaustionDead"}}
        </span>
      {{/if}}
    </div>
    <div class="exhaustion-pips">
      {{#each exhaustionPips as |pip|}}
        <button type="button" 
                class="diamond-pip {{#if pip.active}}active{{/if}} {{#if (eq pip.value 6)}}pip-death{{/if}}" 
                data-action="setExhaustion" 
                data-value="{{pip.value}}" 
                title="{{#if (eq pip.value 6)}}{{localize 'GAIA.Banner.ExhaustionLevel6'}}{{else}}{{localize 'GAIA.Banner.ExhaustionLevel'}} {{pip.value}}{{/if}}">
          {{#if (eq pip.value 6)}}
            <i class="fa-solid fa-skull"></i>
          {{else}}
            <i class="fa-solid fa-diamond"></i>
          {{/if}}
        </button>
      {{/each}}
    </div>
    <input type="hidden" name="system.exhaustion" value="{{system.exhaustion}}" />
  </div>

  {{!-- 8. Acesso à Janela de Dado de Morte (quando Incapacitado/0 PV/Estabilizado) --}}
  {{#if showDeathCard}}
    <div class="death-save-trigger-card {{#if isDeadByDeathDie}}dead-state{{/if}} {{#if isStabilized}}stabilized-state{{/if}}" 
         data-action="openDeathSaveDialog" 
         role="button" 
         data-tooltip="{{tooltips.deathDie}}&#10;Clique para abrir a Janela do Dado de Morte">
      <div class="death-trigger-header">
        <span>{{localize "GAIA.DeathDie.Title"}}</span>
      </div>
      <div class="death-trigger-status">
        {{#if isDeadByDeathDie}}
          <span class="exhaustion-dead-badge"><i class="fa-solid fa-skull"></i> {{localize "GAIA.Banner.ExhaustionDead"}}</span>
        {{else if isStabilized}}
          <span class="stabilized-badge"><i class="fa-solid fa-shield-heart"></i> {{localize "GAIA.DeathDie.Stabilized"}}</span>
        {{else}}
          <span class="death-trigger-counts">{{system.death.sentences}}/2 &nbsp;|&nbsp;{{system.death.gifts}}/2</span>
        {{/if}}
      </div>
    </div>
  {{/if}}

  {{!-- 8. Lista de Estatísticas e Defesas Inferiores --}}
  <div class="banner-defenses-list">
    {{!-- Percepção Passiva --}}
    <div class="defense-item passive-perception-item" data-tooltip="{{tooltips.passivePerception}}">
      <span class="defense-item-label">{{localize "GAIA.Banner.PassivePerception"}}</span>
      <input type="number" class="defense-item-val" name="system.passivePerception" value="{{system.passivePerception}}" min="0" />
    </div>

    {{!-- Resistência --}}
    <div class="defense-group">
      <div class="defense-group-header">
        <span class="defense-group-title">{{localize "GAIA.Banner.Resistance"}}</span>
        <button type="button" class="btn-tag-add" data-action="addResistance">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
      <div class="defense-tags">
        {{#each system.damageResistance as |res index|}}
          <div class="defense-tag">
            <select name="system.damageResistance.{{index}}.type">
              {{selectOptions ../config.damageTypesFlat selected=res.type localize=true}}
            </select>
            <button type="button" class="btn-tag-remove" data-action="removeResistance" data-index="{{index}}" data-tooltip="{{localize 'GAIA.Banner.Remove'}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        {{else}}
          <span class="empty-placeholder">{{localize "GAIA.Banner.None"}}</span>
        {{/each}}
      </div>
    </div>

    {{!-- Imunidade --}}
    <div class="defense-group">
      <div class="defense-group-header">
        <span class="defense-group-title">{{localize "GAIA.Banner.Immunity"}}</span>
        <button type="button" class="btn-tag-add" data-action="addImmunity" data-tooltip="{{localize 'GAIA.Banner.AddImmunity'}}">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
      <div class="defense-tags">
        {{#each system.damageImmunity as |imm index|}}
          <div class="defense-tag">
            <select name="system.damageImmunity.{{index}}.type">
              {{selectOptions ../config.damageTypesFlat selected=imm.type localize=true}}
            </select>
            <button type="button" class="btn-tag-remove" data-action="removeImmunity" data-index="{{index}}" data-tooltip="{{localize 'GAIA.Banner.Remove'}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        {{else}}
          <span class="empty-placeholder">{{localize "GAIA.Banner.None"}}</span>
        {{/each}}
      </div>
    </div>

    {{!-- Redução --}}
    <div class="defense-group">
      <div class="defense-group-header">
        <span class="defense-group-title">{{localize "GAIA.Banner.Reduction"}}</span>
        <button type="button" class="btn-tag-add" data-action="addReduction" data-tooltip="{{localize 'GAIA.Banner.AddReduction'}}">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
      <div class="defense-tags">
        {{#each system.damageReduction as |red index|}}
          <div class="defense-tag reduction-tag">
            <select class="reduction-type" name="system.damageReduction.{{index}}.type">
              {{selectOptions ../config.damageTypesFlat selected=red.type localize=true}}
            </select>
            <input type="number" class="reduction-val" name="system.damageReduction.{{index}}.value" value="{{red.value}}" placeholder="0" />
            <button type="button" class="btn-tag-remove" data-action="removeReduction" data-index="{{index}}" data-tooltip="{{localize 'GAIA.Banner.Remove'}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        {{else}}
          <span class="empty-placeholder">{{localize "GAIA.Banner.None"}}</span>
        {{/each}}
      </div>
    </div>
  </div>
</div>
