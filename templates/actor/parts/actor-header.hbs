<div class="gaia-actor-banner">
  {{!-- 1. Nome e Nível --}}
  <div class="banner-top-row">
    <div class="banner-field-card name-field">
      <span class="field-label">{{localize "GAIA.Banner.Name"}}</span>
      <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'GAIA.Banner.CharacterNamePlaceholder'}}" />
    </div>

    <div class="banner-field-card level-field">
      <span class="field-label">{{localize "GAIA.Banner.Level"}}</span>
      <input type="number" name="system.nivel" value="{{system.nivel}}" min="0" />
    </div>
  </div>

  {{!-- 2. Legado / Legacy --}}
  <div class="banner-mid-row">
    <div class="banner-field-card legacy-field legado-field">
      <span class="field-label">{{localize "GAIA.Banner.Legacy"}}</span>
      <input type="text" name="system.legacy" value="{{#if system.legacy}}{{system.legacy}}{{else}}{{system.legacy}}{{/if}}" placeholder="{{localize 'GAIA.Banner.LegacyPlaceholder'}}" />
    </div>
  </div>

  {{!-- 3. Vida (Atual / Max) --}}
  <div class="resource-card health-card">
    <span class="resource-title">{{localize "GAIA.Banner.Health"}}</span>
    <div class="resource-inputs-row">
      <div class="stat-input-box">
        <span class="input-sublabel">{{localize "GAIA.Banner.Current"}}</span>
        <input type="number" name="system.health.value" value="{{system.health.value}}" min="0" />
      </div>
      <div class="stat-input-box" data-tooltip="{{tooltips.healthMax}}" title="{{tooltips.healthMax}}">
        <span class="input-sublabel">{{localize "GAIA.Banner.Max"}}</span>
        <input type="number" name="system.health.max" value="{{system.health.max}}" min="0" />
      </div>
      <div class="stat-input-box">
        <span class="input-sublabel">{{localize "GAIA.Banner.TempHP"}}</span>
        <input type="number" name="system.health.temp" value="{{system.health.temp}}" min="0" />
      </div>
    </div>
  </div>

  {{!-- 4. Energia (Atual / Max) --}}
  <div class="resource-card energy-card">
    <span class="resource-title">{{localize "GAIA.Banner.Energy"}}</span>
    <div class="resource-inputs-row">
      <div class="stat-input-box">
        <span class="input-sublabel">{{localize "GAIA.Banner.Current"}}</span>
        <input type="number" name="system.energy.value" value="{{system.energy.value}}" min="0" />
      </div>
      <div class="stat-input-box">
        <span class="input-sublabel">{{localize "GAIA.Banner.Max"}}</span>
        <input type="number" name="system.energy.max" value="{{system.energy.max}}" min="0" />
      </div>
    </div>
  </div>

  {{!-- 5. Escudos de Defesa: Bloqueio e Agilidade --}}
  <div class="shields-column">
    <span class="shield-title">{{localize "GAIA.Banner.DefenseTitle"}}</span>
    <div class="shields-container"> 
      {{!-- Bloqueio --}}
      <div class="shield-card" 
          data-action="rollDefense" 
          data-type="block" 
          data-context-action="editField" 
          data-field="system.block" 
          data-label="{{localize 'GAIA.Banner.Block'}}" 
          data-type-input="number" 
          data-min="0" 
          role="button" 
          data-tooltip="{{tooltips.block}}"
          title="{{tooltips.block}}&#10;Clique esquerdo: Rolar Defesa | Clique direito: Alterar Bloqueio">
        <div class="shield-frame">
          <div class="shield-content">
            <span class="shield-title">{{localize "GAIA.Banner.Block"}}</span>
            <span class="shield-input">{{#if system.totalBlock}}{{system.totalBlock}}{{else}}{{system.block}}{{/if}}</span>
          </div>
        </div>
      </div>

      {{!-- Agilidade --}}
      <div class="shield-card" 
          data-action="rollDefense" 
          data-type="agility" 
          data-context-action="editField" 
          data-field="parameter.agility" 
          data-label="{{localize 'GAIA.Banner.Agility'}}" 
          data-type-input="number" 
          data-min="0" 
          data-max="6" 
          role="button" 
          title="Clique esquerdo: Rolar Defesa | Clique direito: Alterar Agilidade">
        <div class="shield-frame">
          <div class="shield-content">
            <span class="shield-title">{{localize "GAIA.Banner.Agility"}}</span>
            <span class="shield-value">{{agilityValue}}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{!-- 6. Movimento e Iniciativa --}}
  <div class="move-init-row">
    {{!-- Movimento --}}
    <div class="move-card" 
         data-context-action="editField" 
         data-field="system.movement" 
         data-label="{{localize 'GAIA.Banner.Movement'}}" 
         data-type-input="number" 
         data-min="0" 
         role="button" 
         data-tooltip="{{tooltips.movement}}"
         title="{{tooltips.movement}}&#10;Clique com botão direito para Alterar Movimento">
      <span class="banner-title">{{localize "GAIA.Banner.Movement"}}</span>
      <span class="banner-input">{{system.movement}}</span>
    </div>

    {{!-- Iniciativa --}}
    <div class="init-card" 
         data-action="rollInitiative" 
         data-context-action="editField" 
         data-field="parameter.agility" 
         data-label="{{localize 'GAIA.Banner.Initiative'}} ({{localize 'GAIA.Banner.Agility'}})" 
         data-type-input="number" 
         data-min="0" 
         data-max="6" 
         role="button" 
         title="Clique esquerdo: Rolar Iniciativa | Clique direito: Alterar Agilidade">
      <span class="banner-title">{{localize "GAIA.Banner.Initiative"}}</span>
      <span class="init-value">{{initiativeValue}}</span>
      <span class="init-sub">({{localize "GAIA.Banner.Agility"}})</span>
    </div>
  </div>

  {{!-- 7. Exaustão (5 Pips) --}}
  <div class="exhaustion-card">
    <span class="exhaustion-title">{{localize "GAIA.Banner.Exhaustion"}}</span>
    <div class="exhaustion-pips">
      {{#each exhaustionPips as |pip|}}
        <button type="button" class="diamond-pip {{#if pip.active}}active{{/if}}" data-action="setExhaustion" data-value="{{pip.value}}" title="{{localize 'GAIA.Banner.Exhaustion'}} nível {{pip.value}}">
          <i class="fa-solid fa-diamond"></i>
        </button>
      {{/each}}
    </div>
    <input type="hidden" name="system.exhaustion" value="{{system.exhaustion}}" />
  </div>

  {{!-- 8. Lista de Estatísticas e Defesas Inferiores --}}
  <div class="banner-defenses-list">
    {{!-- Percepção Passiva --}}
    <div class="defense-item passive-perception-item" data-tooltip="{{tooltips.passivePerception}}" title="{{tooltips.passivePerception}}">
      <span class="defense-item-label">{{localize "GAIA.Banner.PassivePerception"}}</span>
      <input type="number" class="defense-item-val" name="system.passivePerception" value="{{system.passivePerception}}" min="0" />
    </div>

    {{!-- Resistência --}}
    <div class="defense-group">
      <div class="defense-group-header">
        <span class="defense-group-title">{{localize "GAIA.Banner.Resistance"}}</span>
        <button type="button" class="btn-tag-add" data-action="addResistance" title="{{localize 'GAIA.Banner.AddResistance'}}">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
      <div class="defense-tags">
        {{#each system.damageResistance as |res index|}}
          <div class="defense-tag">
            <input type="text" name="system.damageResistance.{{index}}.type" value="{{res.type}}" placeholder="{{localize 'GAIA.Banner.TypePlaceholder'}}" />
            <button type="button" class="btn-tag-remove" data-action="removeResistance" data-index="{{index}}" title="{{localize 'GAIA.Banner.Remove'}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        {{else}}
          <span class="empty-placeholder">{{localize "GAIA.Banner.None"}}</span>
        {{/each}}
      </div>
    </div>

    {{!-- Imunidade --}}
    <div class="defense-group">
      <div class="defense-group-header">
        <span class="defense-group-title">{{localize "GAIA.Banner.Immunity"}}</span>
        <button type="button" class="btn-tag-add" data-action="addImmunity" title="{{localize 'GAIA.Banner.AddImmunity'}}">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
      <div class="defense-tags">
        {{#each system.damageImmunity as |imm index|}}
          <div class="defense-tag">
            <input type="text" name="system.damageImmunity.{{index}}.type" value="{{imm.type}}" placeholder="{{localize 'GAIA.Banner.TypePlaceholder'}}" />
            <button type="button" class="btn-tag-remove" data-action="removeImmunity" data-index="{{index}}" title="{{localize 'GAIA.Banner.Remove'}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        {{else}}
          <span class="empty-placeholder">{{localize "GAIA.Banner.None"}}</span>
        {{/each}}
      </div>
    </div>

    {{!-- Redução --}}
    <div class="defense-group">
      <div class="defense-group-header">
        <span class="defense-group-title">{{localize "GAIA.Banner.Reduction"}}</span>
        <button type="button" class="btn-tag-add" data-action="addReduction" title="{{localize 'GAIA.Banner.AddReduction'}}">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
      <div class="defense-tags">
        {{#each system.damageReduction as |red index|}}
          <div class="defense-tag reduction-tag">
            <input type="text" class="reduction-type" name="system.damageReduction.{{index}}.type" value="{{red.type}}" placeholder="{{localize 'GAIA.Banner.TypePlaceholder'}}" />
            <input type="number" class="reduction-val" name="system.damageReduction.{{index}}.value" value="{{red.value}}" placeholder="0" />
            <button type="button" class="btn-tag-remove" data-action="removeReduction" data-index="{{index}}" title="{{localize 'GAIA.Banner.Remove'}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        {{else}}
          <span class="empty-placeholder">{{localize "GAIA.Banner.None"}}</span>
        {{/each}}
      </div>
    </div>
  </div>
</div>
