<div class="personagem-tab-content">
  {{!-- 1. Seção Superior: Imagem/Retrato à esquerda + Parâmetros à direita --}}
  <div class="personagem-top-grid">
    {{!-- Retrato Grande do Personagem --}}
    <div class="portrait-box">
      <img class="character-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt="{{actor.name}}" />
    </div>

    {{!-- Painel de Parâmetros (8 Parâmetros divididos em 2 colunas de 4) --}}
    <div class="parameters-panel">
      <h3 class="panel-main-title">Parâmetros</h3>
      <div class="parameters-columns-grid">
        {{!-- Coluna 1: Precisão, Brutalidade, Destreza, Agilidade --}}
        <div class="stat-pips-column">
          {{#each parametersCol1 as |param|}}
            <div class="pip-stat-row">
              <span class="pip-stat-label" data-action="rollParameter" data-key="{{param.key}}" title="Rolar {{param.label}}">
                <img class="stat-roll-icon" src="icons/svg/d12-grey.svg" alt="d12" />
                {{param.label}}
              </span>
              <div class="pips-bar">
                {{#each param.pips as |pip|}}
                  <button type="button" class="diamond-pip-stat {{#if pip.active}}active{{/if}}" data-action="setParameterPip" data-param="{{param.key}}" data-value="{{pip.value}}" title="{{param.label}} {{pip.value}}">
                    <i class="fa-solid fa-diamond"></i>
                  </button>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </div>

        {{!-- Coluna 2: Canalização, Arcanismo, Espírito, Vigor --}}
        <div class="stat-pips-column">
          {{#each parametersCol2 as |param|}}
            <div class="pip-stat-row">
              <span class="pip-stat-label" data-action="rollParameter" data-key="{{param.key}}" title="Rolar {{param.label}}">
                <img class="stat-roll-icon" src="icons/svg/d12-grey.svg" alt="d12" />
                {{param.label}}
              </span>
              <div class="pips-bar">
                {{#each param.pips as |pip|}}
                  <button type="button" class="diamond-pip-stat {{#if pip.active}}active{{/if}}" data-action="setParameterPip" data-param="{{param.key}}" data-value="{{pip.value}}" title="{{param.label}} {{pip.value}}">
                    <i class="fa-solid fa-diamond"></i>
                  </button>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </div>
      </div>
    </div>
  </div>

  {{!-- 2. Seção Inferior: Conhecimentos à esquerda + Maestrias à direita --}}
  <div class="personagem-bottom-grid">
    {{!-- Painel de Conhecimentos (14 Conhecimentos divididos em 2 colunas de 7) --}}
    <div class="knowledge-panel">
      <h3 class="panel-main-title">Conhecimentos</h3>
      <div class="knowledge-columns-grid">
        {{!-- Coluna 1: Carisma, Con. Místico, Exploração, Furtividade, História, Intimidação, Intuição --}}
        <div class="stat-pips-column">
          {{#each knowledgeCol1 as |know|}}
            <div class="pip-stat-row">
              <span class="pip-stat-label" data-action="rollKnowledge" data-key="{{know.key}}" title="Rolar {{know.label}}">
                <img class="stat-roll-icon" src="icons/svg/d12-grey.svg" alt="d12" />
                {{know.label}}
              </span>
              <div class="pips-bar">
                {{#each know.pips as |pip|}}
                  <button type="button" class="diamond-pip-stat {{#if pip.active}}active{{/if}}" data-action="setKnowledgePip" data-knowledge="{{know.key}}" data-value="{{pip.value}}" title="{{know.label}} {{pip.value}}">
                    <i class="fa-solid fa-diamond"></i>
                  </button>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </div>

        {{!-- Coluna 2: Medicina, Percepção, Performance, Religião, Sobrevivência, Tecnologia, Vontade --}}
        <div class="stat-pips-column">
          {{#each knowledgeCol2 as |know|}}
            <div class="pip-stat-row">
              <span class="pip-stat-label" data-action="rollKnowledge" data-key="{{know.key}}" title="Rolar {{know.label}}">
                <img class="stat-roll-icon" src="icons/svg/d12-grey.svg" alt="d12" />
                {{know.label}}
              </span>
              <div class="pips-bar">
                {{#each know.pips as |pip|}}
                  <button type="button" class="diamond-pip-stat {{#if pip.active}}active{{/if}}" data-action="setKnowledgePip" data-knowledge="{{know.key}}" data-value="{{pip.value}}" title="{{know.label}} {{pip.value}}">
                    <i class="fa-solid fa-diamond"></i>
                  </button>
                {{/each}}
              </div>
            </div>
          {{/each}}
        </div>
      </div>
    </div>

    {{!-- Painel de Maestrias --}}
    <div class="masteries-panel">
      <div class="masteries-header">
        <h3 class="panel-main-title">Maestrias</h3>
        <button type="button" class="btn-add-mastery" data-action="addMastery" title="Adicionar Maestria">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>

      <div class="masteries-list">
        {{#each unlockedMasteries as |mastery index|}}
          <div class="mastery-item">
            <span class="mastery-name">{{mastery.label}}</span>
            <button type="button" class="btn-remove-mastery" data-action="removeMastery" data-index="{{index}}" title="Remover Maestria">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
        {{else}}
          <span class="empty-masteries-hint">Nenhuma maestria adquirida. Clique em + para adicionar.</span>
        {{/each}}
      </div>
    </div>
  </div>
</div>
