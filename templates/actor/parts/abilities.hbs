<div class="tab abilities" data-group="primary" data-tab="abilities">
  <div class="tab-abilities-content">
    <div class="abilities-panel">

      <div class="header-buttons" style="display: flex; gap: 6px;">
        <button type="button" class="btn-open-browser" data-action="openItemBrowser" data-type="ability"
          title="{{localize 'GAIA.ItemBrowser.OpenAbilitiesBrowser'}}">
          {{localize "GAIA.ItemBrowser.OpenAbilitiesBrowser"}}
        </button>

        <div class="section-actions">
          <button type="button" class="btn-toggle-all-abilities" data-action="toggleAllAbilitiesCollapse"
            title="Recolher / Expandir Habilidades">
            <i class="fa-solid fa-angles-up-down"></i> Recolher / Expandir
          </button>
          {{#if legacyItem}}
          <button type="button" class="btn-open-legacy-sheet" data-action="openLegacyItem"
            data-item-id="{{legacyItem.id}}" data-item-uuid="{{legacyItem.uuid}}"
            title="Abrir Ficha do Legado ({{legacyItem.name}})">
            <i class="fa-solid fa-feather-pointed"></i> Ver Legado
          </button>
          {{/if}}
        </div>
      </div>

      <div class="legacy-abilities-section">
        {{!-- Filtros: origem (Caminho / Legado) e Caminho específico --}}
        <div class="ability-filters">
          <div class="filter-select-box">
            <label for="ability-source-filter"><i class="fa-solid fa-layer-group"></i>
              {{localize "GAIA.Ability.SourceFilterLabel"}}:</label>
            <select id="ability-source-filter" class="ability-source-select" data-ability-filter="source">
              {{#each abilitySourceOptions as |option|}}
              <option value="{{option.value}}" {{#if (eq option.value ../abilityFilters.source)}}selected{{/if}}>
                {{option.label}}
              </option>
              {{/each}}
            </select>
          </div>

          {{#if abilityFilters.showPathFilter}}
          <div class="filter-select-box">
            <label for="ability-path-filter"><i class="fa-solid fa-route"></i>
              {{localize "GAIA.Ability.PathFilterLabel"}}:</label>
            <select id="ability-path-filter" class="ability-path-select" data-ability-filter="path">
              <option value="all" {{#if abilityFilters.isPathAll}}selected{{/if}}>{{abilityAllPathsLabel}}</option>
              {{#each abilityFilterPaths as |pathOption|}}
              <option value="{{pathOption.id}}" {{#if (eq pathOption.id ../abilityFilters.path)}}selected{{/if}}>
                {{pathOption.name}}
              </option>
              {{/each}}
            </select>
          </div>
          {{/if}}
        </div>

        <div class="abilities-list-grid">
          {{#each filteredAbilityCards}}
          <div
            class="ability-card-item {{#if this.sourceLabel}}ability-card-{{this.source}}{{/if}} {{#if this.isCollapsed}}is-collapsed{{/if}}"
            data-index="{{this.index}}" data-item-id="{{this.id}}" data-legacy-index="{{this.legacyIndex}}"
            data-source="{{this.source}}" data-path-id="{{this.pathId}}">

            {{!-- MINI CABEÇALHO COM CONTROLES --}}
            <div class="ability-card-controls">
              {{#if this.activeEffectText}}
              <button type="button" class="btn-item-control btn-create-effect {{#if this.isEffectActive}}active{{/if}}"
                {{#if this.id}}data-action="createAbilityEffect" data-item-id="{{this.id}}"
                {{else}}data-action="createEffect" data-index="{{this.legacyIndex}}"{{/if}}
                title="{{#if this.isEffectActive}}Desativar Efeito Ativo{{else}}Criar / Ativar Efeito no Personagem{{/if}}">
                <i class="fa-solid fa-sparkles"></i>
              </button>
              {{/if}}

              {{#if this.id}}
              <button type="button" class="btn-item-control btn-roll-ability" data-action="rollItem"
                data-item-id="{{this.id}}" title="{{localize 'GAIA.Ability.SendToChat'}}">
                <i class="fas fa-comment-alt"></i>
              </button>
              <button type="button" class="btn-item-control btn-edit-ability" data-action="openItem"
                data-item-id="{{this.id}}" title="{{localize 'GAIA.title.EditItem'}}">
                <i class="fas fa-edit"></i>
              </button>
              <button type="button" class="btn-item-control btn-delete-ability" data-action="deleteItem"
                data-item-id="{{this.id}}" title="{{localize 'GAIA.title.DeleteItem'}}">
                <i class="fas fa-trash"></i>
              </button>
              {{else}}
              <button type="button" class="btn-item-control btn-roll-legacy-ability" data-action="rollLegacyAbility"
                data-index="{{this.legacyIndex}}" title="{{localize 'GAIA.Ability.SendToChat'}}">
                <i class="fas fa-comment-alt"></i>
              </button>
              {{/if}}

              <button type="button" class="btn-item-control btn-toggle-ability-collapse" data-action="toggleAbilityCollapse"
                title="Recolher / Expandir Habilidade">
                <i class="fa-solid fa-chevron-down toggle-icon"></i>
              </button>
            </div>

            {{!-- TEMPLATE VISUAL DA CARTA DE HABILIDADE --}}
            <div class="gaia-ability-card actor-sheet-card">
              <div class="ability-card-header" data-action="toggleAbilityCollapse" title="Clique para recolher ou expandir">
                <div class="ability-title-row">
                  <img class="ability-icon" src="{{this.img}}" {{#if this.id}}data-action="openItem"
                    data-item-id="{{this.id}}" {{/if}} title="{{this.name}}" />
                  <div class="ability-title-texts">
                    <h2 class="ability-name-display">{{this.name}}</h2>
                    <span class="ability-source-badge">
                      <i class="fa-solid {{this.sourceIcon}}"></i> {{this.sourceBadge}}
                    </span>
                  </div>
                </div>
                {{#if (or this.metaRow1 this.hasAdditionalTypes)}}
                <div class="ability-meta-bar">
                  {{#if this.metaRow1}}
                  <div class="meta-row-1">{{{this.metaRow1}}}</div>
                  {{/if}}
                  {{#if this.hasAdditionalTypes}}
                  <div class="meta-row-2">{{this.additionalTypes}}</div>
                  {{/if}}
                </div>
                {{/if}}
              </div>

              <div class="ability-card-body">
                {{#if this.description}}
                <div class="ability-body-text">
                  <p>{{this.description}}</p>
                </div>
                {{/if}}

                {{#if this.activeEffectText}}
                <div class="ability-effect-display">
                  <span><strong>Efeito:</strong> {{this.activeEffectText}}</span>
                  <button type="button" class="btn-apply-effect-inline {{#if this.isEffectActive}}active{{/if}}"
                    {{#if this.id}}data-action="createAbilityEffect" data-item-id="{{this.id}}"
                    {{else}}data-action="createEffect" data-index="{{this.legacyIndex}}"{{/if}}>
                    <i class="fa-solid fa-sparkles"></i> {{#if this.isEffectActive}}Ativo{{else}}Criar Efeito{{/if}}
                  </button>
                </div>
                {{/if}}

                {{#if this.system.quote}}
                <div class="ability-quote-display">
                  <em>{{this.system.quote}}</em>
                </div>
                {{/if}}

                {{#if (or this.system.numberTarget this.system.range this.system.duration)}}
                <div class="ability-meta-text">
                  {{#if this.system.numberTarget}}
                  <span class="tag-target"><strong>{{localize "GAIA.Ability.Target"}}:</strong>
                    {{this.system.numberTarget}}</span>
                  {{/if}}
                  {{#if this.system.range}}
                  <span class="tag-range"><strong>{{localize "GAIA.Ability.Range"}}:</strong>
                    {{this.system.range}}</span>
                  {{/if}}
                  {{#if this.system.duration}}
                  <span class="tag-duration"><strong>{{localize "GAIA.Ability.Duration"}}:</strong>
                    {{this.system.duration}}</span>
                  {{/if}}
                </div>
                {{/if}}

                {{!-- Habilidades de Legado: lista de ações simples do Legado --}}
                {{#if this.action}}
                <div class="ability-actions-section">
                  <div class="ability-action-item">
                    <div class="ability-action-header-row">
                      <div class="ability-action-info">
                        <span class="ability-action-name">{{this.action.name}}</span>
                        {{#if this.action.cost}}<span class="badge cost-badge">{{this.action.cost}}</span>{{/if}}
                      </div>
                      <button type="button" class="btn-roll-ability-action" data-action="rollLegacyAbility"
                        data-index="{{this.legacyIndex}}" title="Rolar {{this.action.name}}">
                        <i class="fa-solid fa-dice-d20"></i>
                      </button>
                    </div>
                  </div>
                </div>
                {{/if}}

                {{!-- Habilidades de Caminho: ações estruturadas --}}
                {{#if this.system.actions.length}}
                <div class="ability-actions-section">
                  {{#each this.system.actions}}
                  <div class="ability-action-item">
                    <div class="ability-action-header-row">
                      <div class="ability-action-info">
                        <span class="ability-action-name">{{this.name}}</span>
                        {{#if this.cost}}<span class="badge cost-badge">{{this.cost}}</span>{{/if}}
                      </div>
                      <div class="ability-action-controls" style="display: flex; align-items: center; gap: 4px;">
                        <button type="button" class="btn-item-control btn-roll-ability" data-action="rollActionText"
                          data-item-id="{{../id}}" data-action-id="{{this.id}}" data-action-index="{{@index}}"
                          title="{{localize 'GAIA.title.SendToChat'}}">
                          <i class="fas fa-comment-alt"></i>
                        </button>
                        <button type="button" class="btn-roll-ability-action" data-action="rollAction"
                          data-item-id="{{../id}}" data-action-id="{{this.id}}" data-action-index="{{@index}}"
                          title="Rolar {{this.name}}">
                          <i class="fa-solid fa-dice-d20"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                  {{/each}}
                </div>
                {{/if}}

                {{#if this.formattedSubEffects.length}}
                <div class="subeffects-display-section">
                  {{#each this.formattedSubEffects}}
                  <div class="subeffect-display-block" data-subeffect-index="{{@index}}">
                    <div class="subeffect-display-header">
                      <div class="subeffect-identity">
                        <span class="subeffect-title-text">{{this.name}}</span>
                        <div class="subeffect-meta-badges">
                          {{#if this.actionTypeLabel}}<span
                            class="subeffect-meta-badge action-badge">{{this.actionTypeLabel}}</span>{{/if}}
                          {{#if this.typeLabel}}<span
                            class="subeffect-meta-badge type-badge">{{this.typeLabel}}</span>{{/if}}
                          {{#if this.cost}}<span class="subeffect-cost-text">{{this.cost}}</span>{{/if}}
                        </div>
                      </div>
                      <div class="subeffect-controls">
                        <button type="button" class="btn-roll-subeffect" data-action="rollSubEffect"
                          data-item-id="{{../id}}" data-index="{{@index}}" title="Enviar Sub-Habilidade para o Chat">
                          <i class="fas fa-comment-alt"></i>
                        </button>
                        <button type="button" class="btn-item-control btn-toggle-ability-collapse"
                          data-action="toggleAbilityCollapse" title="Recolher / Expandir Habilidade">
                          <i class="fa-solid fa-chevron-down toggle-icon"></i>
                        </button>
                      </div>
                    </div>

                    {{#if this.description}}
                    <div class="subeffect-desc-text">{{this.description}}</div>
                    {{/if}}
                    {{#if this.note}}<div class="subeffect-note-text">{{this.note}}</div>{{/if}}

                    {{#if this.actions.length}}
                    <div class="subeffect-actions-list ability-actions-section">
                      {{#each this.actions}}
                      <div class="ability-action-item">
                        <div class="ability-action-header-row">
                          <div class="ability-action-info">
                            <span class="ability-action-name">{{this.name}}</span>
                            {{#if this.cost}}<span class="badge cost-badge">{{this.cost}}</span>{{/if}}
                          </div>
                          <div class="ability-action-controls" style="display: flex; align-items: center; gap: 4px;">
                            <button type="button" class="btn-item-control btn-roll-ability" data-action="rollActionText"
                              data-item-id="{{../../id}}" data-subeffect-index="{{@../index}}" data-action-id="{{this.id}}"
                              data-action-index="{{@index}}" title="{{localize 'GAIA.title.SendToChat'}}">
                              <i class="fas fa-comment-alt"></i>
                            </button>
                            <button type="button" class="btn-roll-ability-action" data-action="rollAction"
                              data-item-id="{{../../id}}" data-subeffect-index="{{@../index}}" data-action-id="{{this.id}}"
                              data-action-index="{{@index}}" title="Rolar {{this.name}}">
                              <i class="fa-solid fa-dice-d20"></i>
                            </button>
                          </div>
                        </div>
                      </div>
                      {{/each}}
                    </div>
                    {{/if}}
                  </div>
                  {{/each}}
                </div>
                {{/if}}

                {{#if this.hasActiveImprovements}}
                <div class="improvements-display-section">
                  <div class="improvements-divider-title">
                    <span class="dot">•</span>
                    <span class="improvements-title-text">{{localize "GAIA.Ability.Improvements"}}</span>
                    <span class="dot">•</span>
                  </div>
                  <div class="improvements-display-list">
                    {{#each this.activeImprovements}}
                    <div class="improvement-display-item">
                      <strong>{{this.title}}:</strong> {{this.description}}
                    </div>
                    {{/each}}
                  </div>
                </div>
                {{/if}}

              </div>
            </div>
          </div>
          {{/each}}
        </div>

        {{#unless hasAbilityCards}}
        <div class="abilities-empty-state">
          {{#if hasAnyAbilityCards}}
          {{abilityNoMatchLabel}}
          {{else}}
          {{abilityEmptyLabel}}
          {{/if}}
        </div>
        {{/unless}}
      </div>
    </div>
  </div>
</div>
